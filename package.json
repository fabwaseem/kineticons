{
  "name": "kineticons-monorepo",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" build",
    "build:web": "pnpm --filter web build",
    "dev": "pnpm --filter web dev",
    "typecheck": "pnpm -r typecheck",
    "check": "tsx scripts/motions/check.ts && tsx scripts/motions/gaps.ts",
    "import-icons": "tsx scripts/import-icons.ts",
    "lint:packages": "pnpm -r --filter \"./packages/**\" lint:package",
    "changeset": "changeset",
    "release": "pnpm build && node scripts/publish.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.6",
    "publint": "^0.3.25",
    "svg-path-bbox": "^2.1.0",
    "svgpath": "2.6.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
