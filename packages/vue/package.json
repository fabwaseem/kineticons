{
  "name": "@kineticons/vue",
  "version": "0.1.0",
  "description": "2,000+ rounded Vue 3 icons in outline, duotone and filled, each with a motion of its own.",
  "keywords": [
    "icons",
    "svg",
    "animated",
    "animation",
    "motion",
    "duotone",
    "icon-set",
    "kineticons",
    "vue",
    "vue3",
    "nuxt",
    "vue-component"
  ],
  "license": "MIT",
  "author": "Waseem Anjum",
  "homepage": "https://kineticons.fabwaseem.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fabwaseem/kineticons.git",
    "directory": "packages/vue"
  },
  "bugs": "https://github.com/fabwaseem/kineticons/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./icons": {
      "import": {
        "types": "./dist/data.d.mts",
        "default": "./dist/data.mjs"
      },
      "require": {
        "types": "./dist/data.d.cts",
        "default": "./dist/data.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsx ../../scripts/build-packages.ts && tsdown",
    "typecheck": "tsc --noEmit",
    "lint:package": "publint && attw --pack . --profile node16"
  },
  "dependencies": {
    "@kineticons/core": "workspace:^"
  },
  "peerDependencies": {
    "vue": ">=3.3"
  },
  "devDependencies": {
    "vue": "^3.5.0",
    "tsdown": "^0.20.0"
  },
  "engines": {
    "node": ">=18"
  }
}
